{
  "version": 2,
  "rewrites": [
    {
      "source": "/v1/loaders/:id",
      "destination": "/api/loader?id=:id"
    },
    {
      "source": "/v1/loaders",
      "destination": "/api/loader"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
